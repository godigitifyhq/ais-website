# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Ignore all markdown files
*.md

# Except these
!README.md

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# video masters — kept locally, never committed. The web encodes derived from
# them (hero-loop, campus-tour, admission-story, robotics-lab-film,
# sports-campus) ARE committed and are what the site actually serves.
/public/video/hero.mp4
/public/video/admission-page.mp4
/public/video/robotics-lab.mp4
/public/video/sports-new.mp4

# scratch
/.tmp-video/
